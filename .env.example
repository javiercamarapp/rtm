# Copia a .env.local con `node scripts/entorno/generar-env-local.mjs` (lo llena desde `supabase status`).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Pimienta del limite de intentos (secreto del servidor, nunca NEXT_PUBLIC_).
LIMITE_PIMIENTA=

# Integraciones privadas (solo en el servidor; ningun valor va al repo). Sin ellas, cada integracion queda apagada.
# Telegram: token del bot y secreto de la cabecera del webhook. Los ids de Telegram de los socios y del grupo se cargan con
#   `node scripts/agente/registrar-miembros.mjs` desde TELEGRAM_MIEMBROS (JSON privado), nunca desde el repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MIEMBROS=
OPENROUTER_API_KEY=
# Secreto de las tareas programadas (cabecera Authorization: Bearer ...).
TAREAS_SECRETO=
# Fuente del inventario de proveedores (direccion privada; nunca en pantalla ni en el repo) y contacto del negocio para el agente de usuario.
INVENTARIO_PROVEEDORES_FUENTE=
INVENTARIO_PROVEEDORES_CONTACTO=
