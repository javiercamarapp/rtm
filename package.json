{
  "name": "rtm",
  "version": "0.0.0",
  "private": true,
  "description": "RTM: software de la bodega de Mérida (fase F0: acceso, armazón visual y guardas).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test",
    "test": "vitest run",
    "cobertura:graficas": "vitest run --coverage",
    "guardas": "node scripts/ci/guardas.mjs",
    "secretos": "node scripts/ci/escaner-secretos.mjs",
    "db:iniciar": "node scripts/entorno/supabase.mjs iniciar",
    "db:detener": "node scripts/entorno/supabase.mjs detener",
    "db:probar": "supabase test db",
    "test:integracion": "vitest run --config vitest.integracion.config.mts",
    "e2e": "playwright test",
    "capturas": "playwright test --config playwright.capturas.config.ts",
    "verificar": "node scripts/ci/verificar.mjs",
    "acceso:alta": "node scripts/acceso/alta-usuarios.mjs",
    "acceso:alta:probar": "node scripts/acceso/alta-usuarios.mjs --dry-run",
    "importar": "tsx scripts/importacion/importar.mts",
    "importar:verificar": "tsx scripts/importacion/importar.mts --verificar",
    "importar:idempotencia": "tsx scripts/importacion/importar.mts --prueba-idempotencia",
    "capturas:f1": "node scripts/capturas/capturas-f1.mjs --restaurar-real",
    "capturas:f2": "node scripts/capturas/capturas-f2.mjs --restaurar-real",
    "capturas:f3a": "node scripts/capturas/capturas-f3a.mjs --restaurar-real",
    "capturas:f3b": "node scripts/capturas/capturas-f3b.mjs --restaurar-real",
    "capturas:f3b-inventario": "node scripts/capturas/capturas-f3b-inventario.mjs --restaurar-real",
    "capturas:apertura": "node scripts/capturas/capturas-apertura.mjs --restaurar-real",
    "latido": "node scripts/latido-local.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^7.4.2",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "^6.5.438",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
