import { chromium } from '@playwright/test';
import { altaUsuario, correoUnico, enlaceConfirmacion } from '../test/e2e/ayudas';
const correo = correoUnico('ver');
await altaUsuario({ correo, socio: 'Javier' });
const b = await chromium.launch();
const page = await (await b.newContext({ viewport: { width: 1440, height: 900 } })).newPage();
await page.goto('http://127.0.0.1:3100' + (await enlaceConfirmacion(correo, '/pedidos')));
await page.getByTestId('confirmar-acceso').click();
await page.waitForURL('**/pedidos');
await page.goto('http://127.0.0.1:3100/pedidos/5');
await page.getByTestId('marcar-enviado-5').click();
const d = page.getByRole('dialog');
await d.getByLabel(/Surtidas de/).fill('40');
await d.getByLabel('Número de guía').fill('GUIA-X');
await d.getByLabel('Costo real de la guía').fill('180');
await page.getByTestId('confirmar').click();
await page.waitForTimeout(2500);
console.log(await d.innerText());
await b.close();
